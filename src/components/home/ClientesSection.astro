---
/**
 * "Meus clientes e empresas" — Figma node 214:237. Carrossel infinito
 * dos logos, separados por "•" (accent). Comportamento pedido pelo
 * usuário: looping infinito e suave (não rápido), desacelera ao passar
 * o mouse por cima (não pausa), volta à velocidade normal ao tirar —
 * ver logoMarqueeLoop.ts.
 *
 * Não inclui o CTA "Vamos conversar" + retângulo placeholder que
 * apareciam também neste frame do Figma (214:238/239) — são os mesmos
 * 2 elementos que o usuário já pediu pra remover da seção Sobre (mesmo
 * padrão se repetindo em vários frames do arquivo — parece um elemento
 * de referência do Figma, não conteúdo real desta seção).
 *
 * Os 2 logos compostos por várias peças SVG pequenas no Figma
 * (Credaluga = 11 sub-grupos posicionados manualmente) foram exportados
 * como UM PNG já achatado (screenshot do node 214:267) em vez de
 * tentar reconstruir o posicionamento absoluto peça por peça — mais
 * fiel e muito mais simples.
 *
 * Correção (mobile usava valores de desktop): comparado contra o Figma
 * 224:574 (mobile) — o overline estava com `text-[16px]
 * tracking-[0.32px]` incondicional, valor de desktop vazando pro
 * mobile (Typography/Mobile/Text/Overline correto é
 * `14px`/`tracking:0.28px`). O espaço abaixo do overline também era só
 * o valor de desktop (`mb-(--spacing-2xl)`=40px) — o frame mobile usa
 * `gap-[16px]` entre overline e a faixa de logos.
 *
 * Correção (pedido do usuário — texto errado): o overline usava "Meus
 * clientes e empresas", que não bate com o texto real do Figma (node
 * 498:1331) — trocado pro texto exato, "CLIENTES E EMPRESAS".
 */
interface LogoItem {
	src: string;
	alt: string;
	width: number;
	height: number;
	/** Estrategia usa um crop/zoom específico do Figma (imagem maior que a caixa). */
	crop?: { width: string; height: string; top: string; left: string };
}

const LOGOS: LogoItem[] = [
	{ src: "/images/clientes/trach.png", alt: "TRACH", width: 39, height: 38 },
	{ src: "/images/clientes/yogha.svg", alt: "Yogha", width: 99, height: 33 },
	{ src: "/images/clientes/tm1.svg", alt: "tm1", width: 78, height: 28 },
	{ src: "/images/clientes/oli.svg", alt: "Oli", width: 37, height: 28 },
	{ src: "/images/clientes/credaluga.png", alt: "Credaluga", width: 164, height: 30 },
	{
		src: "/images/clientes/estrategia.png",
		alt: "Estratégia Educação",
		width: 93,
		height: 28,
		crop: { width: "113.86%", height: "153.36%", top: "-27.61%", left: "-13.86%" },
	},
];

// Renderiza a sequência só UMA vez — logoMarqueeLoop.ts mede a largura
// dela e clona quantas cópias forem necessárias em runtime pra preencher
// qualquer largura de tela sem deixar vão vazio (correção: antes eram
// sempre 2 cópias fixas, insuficiente em telas largas).
---

<section class="bg-(--color-background-dark) py-[96px]">
	<p
		class="mb-(--spacing-md) text-center font-sans text-[14px] tracking-[0.28px] text-(--color-foreground-on-dark) desktop:mb-(--spacing-2xl) desktop:text-[20px] desktop:tracking-[0.4px]"
		data-i18n="clientes.overline"
	>
		CLIENTES E EMPRESAS
	</p>

	<div class="overflow-hidden" data-logo-marquee>
		<div class="flex w-max items-center gap-(--spacing-2xl)" data-logo-marquee-track>
			{
				LOGOS.map((logo) => (
					<>
						<span class="font-sans text-[24px] leading-none text-(--color-accent)" aria-hidden="true">
							•
						</span>
						{logo.crop ? (
							<div class="relative shrink-0 overflow-hidden" style={{ width: `${logo.width}px`, height: `${logo.height}px` }}>
								<img
									src={logo.src}
									alt={logo.alt}
									style={{
										position: "absolute",
										width: logo.crop.width,
										height: logo.crop.height,
										top: logo.crop.top,
										left: logo.crop.left,
										maxWidth: "none",
									}}
								/>
							</div>
						) : (
							<img src={logo.src} alt={logo.alt} width={logo.width} height={logo.height} class="shrink-0" />
						)}
					</>
				))
			}
		</div>
	</div>
</section>

<script>
	import { initLogoMarquee } from "../../lib/logoMarqueeLoop";

	document.querySelectorAll<HTMLElement>("[data-logo-marquee-track]").forEach((track) => {
		initLogoMarquee(track);
	});
</script>
