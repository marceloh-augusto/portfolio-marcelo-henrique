---
import HeroPhoto from "./HeroPhoto.astro";
import Topography from "../ui/Topography.astro";
import ScrollVelocity from "../ui/ScrollVelocity.astro";

// Texto exato pedido pelo usuário (inclui o corte "Desig quem vê" de
// propósito — veio assim na instrução, não é erro de digitação nosso).
const MARQUEE_PHRASE =
	"Design para quem vê • Design para quem sente • Desig quem vê • Design para quem sente • Design para quem vive";
---

<section class="hero-scroll-wrapper relative h-[300vh]" data-hero-scroll-wrapper>
	<div
		class="hero-stage relative flex w-full flex-col overflow-hidden bg-(--color-background-light) px-(--spacing-md-plus) pt-(--spacing-lg) desktop:px-(--spacing-5xl) desktop:pt-(--spacing-lg)"
		data-hero-stage
	>
		<!--
			Overlay de cor escura (correção rodada 9): antes eu animava
			`backgroundColor` do próprio `.hero-stage` — isso força o
			navegador a REPINTAR o stage inteiro (um layer fixed cobrindo a
			tela) a cada tick do scrub. `background-color`/`color` não são
			propriedades "baratas" de animar (ao contrário de `opacity`/
			`transform`, que só recompõem). Trocado por um overlay sólido
			separado cuja OPACIDADE é animada — bem mais barato, e ajuda a
			eliminar o "piscar" causado por frames perdidos no scroll.
		-->
		<div
			class="pointer-events-none absolute inset-0 bg-(--color-background-dark) opacity-0"
			data-hero-dark-overlay
			aria-hidden="true"
		>
		</div>
		<!--
			Fundo animado da Hero (correção: trocado de BlobBackground — 16
			SVGs borrados por variant — pro mesmo Topography/ogl usado em
			#sobre/#cases, a pedido do usuário, pra aparecer já na primeira
			dobra). Mesmo mecanismo de crossfade de antes: wrapper
			`.hero-blob[data-variant=...]` é o alvo do autoAlpha tween no
			script abaixo; o `[data-topography]` interno (dentro do
			Topography) é o alvo do pause/resume (só o variant visível
			renderiza, ver topographyEffect.ts).
		-->
		<!--
			`transition` variant NÃO leva `opacity-0` estático aqui (correção):
			opacity via classe CSS só zera a opacidade, não o `visibility` —
			o canvas continuava `visibility:visible`/`pointer-events:auto`
			mesmo invisível, e por vir depois no DOM (mesmo stacking context,
			sem z-index em nenhum dos dois) ficava POR CIMA do `hero` no
			hit-test, roubando os eventos de mouse dele (o cursor elevation
			simplesmente não reagia). O estado inicial escondido agora é
			setado via `gsap.set(..., { autoAlpha: 0 })` no script abaixo,
			que zera opacity E visibility juntos — igual ao que o tween de
			scroll já faz depois.
		-->
		<div class="hero-blob absolute inset-0" data-variant="hero">
			<Topography
				lowColor="#EFEEEC"
				midColor="#EFEEEC"
				highColor="#EFEEEC"
				speed={0.2}
				morphAmount={2.3}
				morphSpeed={0.04}
				bands={1.5}
				thickness={0.01}
				scale={3}
				pixelSize={1.0}
				glow={0}
				colorMode="elevation"
				contrast={0.2}
				brightness={1.0}
				fillBands={false}
				opacity={1.0}
				grain={false}
				grainIntensity={0}
				mouseInteraction={true}
				mouseRadius={0.42}
				mouseStrength={0.4}
			/>
		</div>
		<div class="hero-blob absolute inset-0" data-variant="transition">
			<Topography
				lowColor="#1F1E1D"
				midColor="#1F1E1D"
				highColor="#1F1E1D"
				speed={0.2}
				morphAmount={2.3}
				morphSpeed={0.04}
				bands={1.5}
				thickness={0.01}
				scale={3}
				pixelSize={1.0}
				glow={0}
				colorMode="elevation"
				contrast={0.2}
				brightness={1.0}
				fillBands={false}
				opacity={1.0}
				grain={false}
				grainIntensity={0}
				mouseInteraction={true}
				mouseRadius={0.42}
				mouseStrength={0.4}
			/>
		</div>
		<div class="opacity-0" data-hero-marquee>
			<!--
				Trocado o MarqueeText/marqueeLoop.ts (loop GSAP simples) pelo
				ScrollVelocity (React Bits, portado sem React/`motion` — ver
				scrollVelocityEffect.ts) a pedido do usuário: mesma ideia de 2
				faixas em direções opostas, mas agora a velocidade reage ao
				scroll real da página (acelera/inverte brevemente conforme
				você rola rápido). Wrapper com as mesmas classes que o
				MarqueeText tinha no próprio root (`.hero-marquee`, usado
				também pelo script de sync com o centro da foto).
			-->
			<div class="hero-marquee pointer-events-none absolute inset-0 flex flex-col justify-center gap-4 overflow-hidden">
				<ScrollVelocity
					texts={[MARQUEE_PHRASE]}
					velocity={40}
					numCopies={4}
					className="font-sans text-[48px] font-bold text-(--color-foreground-on-dark) desktop:text-[96px]"
				/>
				<ScrollVelocity
					texts={[MARQUEE_PHRASE]}
					velocity={-55}
					numCopies={4}
					className="font-sans text-[48px] font-bold text-(--color-muted) desktop:text-[96px]"
				/>
			</div>
		</div>

		<!--
			Top bar (nav+localização+idioma) MOVIDA pra Layout.astro
			(correção: a nav ficava confinada à Hero — `position:absolute`
			relativo ao `.hero-stage` — e desaparecia assim que o scroll saía
			da Hero, sumindo em cima do Cases. Agora é `position:fixed` no
			nível do Layout, visível em qualquer seção). O espaço que ela
			ocupava aqui não precisa mais de nada — o bloco de baixo já
			ocupa a altura inteira do stage independente disso.
		-->

		<!--
			Nome+cargo à esquerda da foto, tagline à direita (correção: a
			rodada 2 tinha centralizado tudo em coluna, revertido a pedido do
			usuário). Alinhamento vertical replica a proporção exata do frame
			de referência do Figma (191:4/214:3, 1440px): a foto vai de y=106
			a y=874 (altura 768); o bloco de nome ocupa y=342 a y=546, ou seja
			(342-106)/768=30,73% a (546-106)/768=57,3% da altura da foto; a
			tagline ocupa y=362 a y=482, ou (362-106)/768=33,33% a
			(482-106)/768=48,96%. Por isso usamos `top-[X%]` em filhos
			absolutos de um wrapper do tamanho exato da foto — `top` em % de
			um elemento absoluto resolve contra a ALTURA do container (ao
			contrário de `margin-top` em %, que resolve contra a largura).

			Horizontal: 416(nome)+967(foto)+341(tagline)=1724px não cabe nem
			no próprio frame de 1440px de referência (1280px de área útil já
			descontando as margens de página) — no Figma original isso só
			"funciona" porque o retângulo da foto tem bastante espaço
			transparente nas bordas e o nome/tagline SOBREPÕEM o retângulo da
			foto (nome sobrepõe 294px dos seus 416px = 30,4%; tagline
			sobrepõe 150px dos seus 341px = 15,5%). Replicamos essa mesma
			sobreposição proporcional aqui (`right-[69.6%]`/`left-[84.49%]`
			em vez de `right-full`/`left-full`), já que sem ela nome/tagline
			vazam pra fora da tela em qualquer largura de janela plausível.

			No mobile isso viraria absoluto fora da tela (não há foto larga o
			bastante pra "encostar" texto do lado) — por isso só vira
			`absolute` a partir do breakpoint desktop; no mobile empilha em
			fluxo normal (ordem do DOM: nome, foto, tagline).

			Z-index (correção rodada 4): a foto (`.hero-photo-slot`, z-30)
			fica ACIMA do nome/tagline (z-20) — antes estava invertido. Onde
			a foto (agora opaca, foto-minha.png) sobrepõe o texto, o texto
			fica escondido atrás dela; só aparece na parte que sobra pra
			fora da foto.
		-->
		<!--
			Bug 1 (correção): a foto deve sempre iniciar alinhada ao canto
			inferior do seu container, centralizada horizontalmente — antes
			usava `items-center` (centralizava verticalmente também), o que
			deixava a foto "flutuando" no meio do espaço disponível em vez de
			encostada embaixo. `items-end` alinha o bloco inteiro (headline +
			foto + tagline, já que viajam juntos como uma unidade) ao fundo
			da área flex-1 disponível, e `justify-center` mantém a
			centralização horizontal — ambos resolvem contra o espaço
			disponível, então funciona em qualquer resolução, não um valor
			fixo em px.
		-->
		<!--
			Correção (bug de interação com o background): este wrapper
			`flex-1` ocupa quase a altura inteira do stage abaixo da nav
			(pra centralizar/alinhar a foto, ver comentário "Bug 1" acima) —
			mesmo nas margens vazias ao redor do nome/foto/tagline, essa
			`<div>` sem `pointer-events-none` capturava o hover/clique antes
			de chegar no Topography atrás dela (era a causa raiz de "não dá
			pra interagir com o fundo": praticamente a tela inteira abaixo da
			nav tinha essa caixa transparente por cima). `pointer-events-auto`
			de volta só no `.hero-photo-slot` (photo precisa do próprio
			parallax, ver HeroPhoto.astro/mouseParallax.ts).
		-->
		<!--
			Responsividade mobile/tablet (pedido do usuário, com print de
			referência): headline+subtítulo+tagline agrupados no TOPO, foto
			colada no FUNDO da viewport — bem diferente do que `items-end`
			incondicional fazia antes (alinhava o BLOCO INTEIRO, headline
			incluso, ao fundo, então o headline nunca ficava "no topo" de
			verdade). Vira `desktop:items-end` (só desktop) — em mobile o
			padrão do flexbox (`align-items:stretch`) faz `.hero-photo-band`
			esticar pra ocupar a altura toda do `flex-1`, dando espaço pro
			truque de `margin-top:auto` na foto funcionar (ver abaixo).
		-->
		<div class="pointer-events-none relative z-10 flex flex-1 justify-center desktop:-mx-[80px] desktop:px-[max(80px,calc((100vw-1440px)/2))] desktop:items-end">
			<!--
				`flex flex-col` (mobile) permite reordenar visualmente via
				`order-*` SEM mexer na ordem do DOM — importante porque a
				posição absoluta do desktop (`top-%`/`left-%`/`right-%` logo
				abaixo) resolve contra ESTE container, e o script GSAP seleciona
				tudo por `data-*` (não por ordem), então nenhum dos dois quebra.
				Em desktop, headline/tagline viram `position:absolute` (saem do
				fluxo flex), sobra só a foto como único item — comporta-se como
				bloco normal, sem efeito colateral.
			-->
			<!--
				Correção (bug real — pedido do usuário mudou a quebra de
				desktop de 1440px pra 1280px): a matemática de overlap do
				headline/tagline em `desktop:` (offsets em % relativos à
				banda) foi calibrada pro frame de referência do Figma
				(1440px) assumindo banda travada em 967px — o comentário
				original já dizia que a composição INTEIRA (headline
				vazando à esquerda + banda + tagline vazando à direita)
				soma ~1280px de largura, encostando exatamente no limite do
				"1440px de frame − 160px de margem = 1280px de área útil".
				Baixar o gatilho de desktop pra 1280px sem tocar nisso fazia
				a tagline vazar ~27px pra fora da tela (cortada pelo
				`overflow:hidden` do stage) bem em 1280px, já que agora o
				VIEWPORT INTEIRO é 1280px, não só a área útil.
				Fix: `desktop:w-[67.15vw]` (967/1440×100, o mesmo percentual
				que a banda ocupa no frame de referência) faz a banda —
				e a foto dentro dela, que é `w-full` da banda — encolher
				fluidamente a partir de 1280px, atingindo exatamente 967px
				(o teto do `max-w` abaixo) só em 1440px+. Como os offsets do
				headline/tagline são percentuais RELATIVOS à banda, eles
				encolhem junto na mesma proporção, sem precisar recalcular
				nada — a 1280px a banda fica com ~860px, deixando espaço
				suficiente pra composição inteira caber sem cortar.
			-->
			<div class="hero-photo-band relative mx-auto flex w-full max-w-[967px] flex-col desktop:block desktop:w-[67.15vw]">
				<div
					class="relative z-20 order-1 mb-(--spacing-lg) text-center tablet:mb-(--spacing-xl) tablet:max-w-[608px] tablet:mx-auto desktop:mb-0 desktop:max-w-none desktop:text-left desktop:absolute desktop:top-[30.73%] desktop:right-[69.6%] desktop:w-[416px]"
					data-hero-headline
				>
					<h1 class="font-sans text-[40px] leading-[1.1] font-bold text-(--color-foreground-on-light) desktop:text-[72px]">
						Marcelo Henrique<span class="text-(--color-accent)">.</span>
					</h1>
					<p
						class="mt-(--spacing-sm) font-sans text-[16px] text-(--color-foreground-on-light) tablet:mt-(--spacing-md) desktop:text-[20px]"
						data-i18n="hero.role"
					>
						UX/UI &amp; Product Designer Senior.
					</p>
				</div>

				<!--
					`order-3` + `mt-auto`: empurra só a FOTO pro fundo do
					container esticado (mobile) — headline (order-1) e tagline
					(order-2) ficam naturalmente no topo. Em desktop não tem
					efeito: o container volta a ser `items-end`/auto-altura (só a
					foto contribui pra altura, headline/tagline são absolutos),
					então não sobra espaço livre pra margem automática consumir.
				-->
				<div
					class="hero-photo-slot pointer-events-auto relative z-30 order-3 mt-auto aspect-[967/768] w-full"
					data-hero-photo-slot
				>
					<HeroPhoto />

					<!--
						Scroll-cue sobreposto na foto (não mais um irmão
						separado abaixo dela), em branco. Sem gradiente atrás
						(removido a pedido do usuário) — se o contraste ficar
						ruim contra fotos mais claras, sinalizar de volta antes
						de reintroduzir qualquer escurecimento.

						Correção (pedido do usuário — texto aparecendo deslocado
						à esquerda, em qualquer resolução): trocado `inset-x-0`
						(que estica a caixa pra largura INTEIRA do container
						pai — `.hero-photo-slot`, que às vezes tem `width:auto`
						setado via JS, ver `syncPhotoHeightBudget` acima) por
						`left-1/2 -translate-x-1/2`, que centraliza a caixa
						pelo PRÓPRIO tamanho dela (shrink-to-fit) em relação ao
						ponto central do pai — não depende da largura do pai
						estar correta/finalizada no momento em que o navegador
						calcula o layout, elimina de vez essa classe de bug.
					-->
					<p
						class="absolute left-1/2 bottom-(--spacing-lg) z-20 -translate-x-1/2 text-center font-sans text-[16px] whitespace-nowrap text-(--color-foreground-on-dark) desktop:text-[20px]"
						data-hero-scrollcue
						data-i18n="hero.scrollcue"
					>
						Role para descobrir como ↓
					</p>
				</div>

				<!--
					Correção (bug real — margem duplicada): o headline
					(acima) já tem `tablet:mb-(--spacing-xl)` (32px) igual ao
					Figma 464:1260 (`gap-[32px]` entre o grupo
					headline+subtítulo e a tagline) — mas a tagline TAMBÉM
					tinha seu próprio `mt-(--spacing-lg)` (24px), e margens
					entre irmãos flex NÃO colapsam (ao contrário de blocos
					normais) — o gap real acabava sendo 32+24=56px, não os
					32px do Figma. `tablet:mt-0` cancela a margem própria da
					tagline a partir do tablet, deixando só a margem do
					headline como fonte do gap (o valor de mobile, sem
					Figma confirmando um número aqui ainda, foi mantido como
					estava).
				-->
				<p
					class="relative z-20 order-2 mx-auto mt-(--spacing-lg) max-w-[600px] text-center font-sans text-[16px] text-(--color-foreground-on-light) tablet:mt-0 desktop:text-[20px] desktop:mx-0 desktop:w-[341px] desktop:max-w-none desktop:text-left desktop:absolute desktop:top-[33.33%] desktop:left-[84.49%]"
					data-hero-tagline
					data-i18n="hero.tagline"
				>
					Transformo <span class="text-(--color-accent)">problemas ambíguos</span> em{" "}
					<span class="text-(--color-accent)">decisões</span> de produto{" "}
					<span class="text-(--color-accent)">fundamentadas</span>, criando{" "}
					<span class="text-(--color-accent)">clareza, critério e direção</span> a partir de uma leitura sistêmica
					que conecta produto, negócio e experiência.
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	/* Correção (bug relatado — Hero maior que a área visível no mobile,
	   empurrando a foto e "Role para descobrir como ↓" pra fora da tela):
	   `h-screen` (Tailwind) compila pra `height:100vh` — mede a altura do
	   viewport com a barra de endereço do navegador RECOLHIDA (o maior
	   valor possível), não a área realmente visível no momento em que a
	   página carrega (barra ainda expandida). `100dvh` mede a altura
	   VISÍVEL de verdade, ajustando sozinha quando a barra
	   recolhe/expande.
	   `@supports` em vez de duas declarações de `height` na mesma regra
	   (tentativa 1, revertida): o minificador de CSS do build colapsa
	   declarações duplicadas da mesma propriedade e mantém só a última
	   (`100dvh`), JOGANDO FORA o fallback `100vh` — testado e confirmado
	   no `dist/` gerado. `@supports` são regras SEPARADAS, o minificador
	   não as funde, então o fallback sobrevive ao build: browsers sem
	   suporte a `dvh` (Safari <15.4, Chrome Android <108) nunca satisfazem
	   a condição do `@supports` e ficam com `100vh`; quem suporta aplica
	   a regra de dentro por cima. */
	.hero-stage {
		height: 100vh;
	}

	@supports (height: 100dvh) {
		.hero-stage {
			height: 100dvh;
		}
	}
</style>

<script>
	import "../../lib/gsapSetup"; // registra o ScrollTrigger como side-effect
	import { gsap, ScrollTrigger } from "../../lib/gsapSetup";
	import { prefersReducedMotion } from "../../lib/reducedMotion";
	import { pauseTopography, resumeTopography } from "../../lib/topographyEffect";
	import { DESKTOP_MEDIA_QUERY, DESKTOP_BREAKPOINT_PX } from "../../lib/breakpoints";
	import { applyPinnedStageWidthFix } from "../../lib/pinnedStageWidthFix";

	const wrapper = document.querySelector<HTMLElement>("[data-hero-scroll-wrapper]");
	const stage = document.querySelector<HTMLElement>("[data-hero-stage]");

	// Correção (regressão reportada pelo usuário — headline espremida sob
	// a nav): a versão anterior media `siteNav.getBoundingClientRect().
	// bottom`. `getBoundingClientRect` reflete TRANSFORMS, e
	// `initAutoHideNav` (autoHideNav.ts) escreve `transform:
	// translateY(-150%)` nesse MESMO elemento toda vez que o usuário rola
	// pra baixo. Se um `resize` acontecesse com a nav escondida — e no
	// mobile isso é a REGRA, não exceção: o colapso da barra de URL
	// dispara `resize` exatamente durante o scroll pra baixo, o único
	// momento em que a nav fica escondida — o `bottom` medido virava
	// ~alguns px em vez da altura real, e o padding-top computado
	// congelava pequeno demais. Como nada re-sincroniza isso em `scroll`
	// puro, o valor errado persistia mesmo depois de voltar ao topo (nav
	// visível de novo, headline por baixo dela).
	//
	// Fix: medir de forma imune a transform — `offsetHeight` (altura de
	// layout, ignora transform) + o `top` COMPUTADO da nav (valor usado
	// da propriedade CSS, também ignora transform, e acompanha sozinho
	// qualquer mudança futura em `top-(--spacing-lg)` na Layout.astro).
	//
	// Nota: o comentário antigo aqui justificava a medição dinâmica com
	// "a nav quebra em 2 linhas em telas estreitas (~232px)" — isso não
	// vale mais. Abaixo de 1280px a `NavPill` de desktop é `hidden` e
	// sobram só o hambúrguer (44px) e o `LanguageToggle` (44x72px): no
	// pior caso medido (768px, com o label "Santa Catarina - BR" visível)
	// isso ocupa ~274px dos ~728px disponíveis — nunca quebra linha.
	// Mantida a medição dinâmica mesmo assim (custo zero, protege
	// qualquer mudança futura na nav), só corrigida a fonte do bug real.
	const siteNav = document.querySelector<HTMLElement>("[data-site-nav]");
	const photoSlot = document.querySelector<HTMLElement>("[data-hero-photo-slot]");
	const desktopMq = window.matchMedia(DESKTOP_MEDIA_QUERY);
	const tabletMq = window.matchMedia("(min-width: 768px)");
	function syncMobileTopSpacing() {
		if (!siteNav || !stage) return;
		if (desktopMq.matches) {
			stage.style.removeProperty("padding-top");
			return;
		}
		const navTop = parseFloat(getComputedStyle(siteNav).top) || 0;
		const navBottom = navTop + siteNav.offsetHeight;
		// Correção (pedido do usuário — nova instrução explícita nesta
		// sessão, sobrepõe o valor medido antes no Figma 464:1260/tablet,
		// que era 40px): no intervalo 768-1279px (tablet) o buffer agora é
		// 32px; abaixo de 768px (mobile de verdade) mantém os 40px
		// originais, já que não houve pedido pra mudar o mobile.
		const buffer = tabletMq.matches ? 32 : 40;
		stage.style.paddingTop = `${Math.max(navBottom + buffer, 0)}px`;
	}

	// Bug real (reportado pelo usuário — foto cortando perto do rosto,
	// em qualquer largura, mas só aparece em VIEWPORTS BAIXOS — testei
	// especificamente 768/1024/1439px de largura x altura normal e não
	// reproduziu; reproduziu sim em 1024x700 E também em 1440x700, ou
	// seja, é a ALTURA que causa isso, não a largura/breakpoint): a foto
	// (`.hero-photo-slot`) tem proporção fixa 967:768 e tamanho guiado só
	// pela LARGURA disponível (`w-full`/`aspect-[967/768]` no mobile,
	// tamanho natural 967x768 no desktop) — nunca leva em conta a
	// ALTURA real da viewport. `.hero-stage` é `h-screen` (100vh) com
	// `overflow:hidden`; numa tela baixa (~700px, comum em notebooks
	// com barra de favoritos/extensões, ou telas físicas mais baixas), a
	// soma de padding-top (nav) + headline + tagline + a foto (768px de
	// altura sozinha) estoura os 700px disponíveis, e o `overflow:hidden`
	// simplesmente CORTA o excesso — cortando a foto perto do queixo/
	// testa dependendo de como a caixa fica alinhada.
	//
	// Fix: mede o espaço vertical REAL que sobra pra foto dentro do
	// stage (do topo da própria foto até o fim do stage, com uma
	// pequena margem de segurança) — mesmo padrão de medição em runtime
