					applyPinnedStageWidthFix(stage!);
					// Correção (regressão que voltou depois da 1ª tentativa de
					// corrigir o bug 1 — headline ainda espremida sob a nav ao
					// redimensionar uma janela larga pra estreita, sem reload):
					// o `pin: stage` do GSAP TIRA UM RETRATO do `padding`
					// computado do elemento no momento em que pina (pra manter
					// a caixa visualmente idêntica ao virar `position:fixed`) e
					// REAPLICA esse retrato como `style.padding` (shorthand) a
					// cada refresh — sobrescrevendo por cima de qualquer
					// `stage.style.paddingTop` que `syncMobileTopSpacing`
					// (window resize listener, mais abaixo) tivesse acabado de
					// escrever. Mesma categoria do bug já visto com `margin`
					// no CasesSection (GSAP também gerencia esse valor no
					// elemento que pina). Fix: chamar `syncMobileTopSpacing`
					// de novo AQUI DENTRO, depois que o GSAP já reaplicou seu
					// retrato — garante que nosso valor seja o último a
					// escrever, sempre que o ScrollTrigger reavaliar (inclusive
					// em resize).
					syncMobileTopSpacing();
					// `stageCenter` (cache usado por `syncMarqueeToPhotoCenter`,
					// ver comentário acima de onde é declarado) também precisa
					// ser recalculado aqui — o retângulo do stage muda de
					// verdade com o `width`/`left`/padding que este mesmo
					// `onRefresh` acabou de reaplicar.
					syncStageCenter();
				},
				onUpdate(self) {
					// Correção (cursor elevation não reagia, causa raiz): o
					// refresh inicial do ScrollTrigger (pin) chama este
					// onUpdate com `progress` ligeiramente > 0 (ponto
					// flutuante, ex: 5.49e-7), mesmo sem nenhum scroll real
					// ter acontecido — comparar contra `> 0` cru fazia o
					// "transition" já entrar como "deveria estar tocando" no
					// primeiro frame, roubando os eventos de mouse do "hero"
					// visível. Um pequeno epsilon evita esse falso positivo.
					const PROGRESS_EPSILON = 0.001;
					const shouldPlayHero = self.progress < MAIN_TRANSITION;
					if (shouldPlayHero !== heroPlaying) {
						heroPlaying = shouldPlayHero;
						heroBlob.style.pointerEvents = shouldPlayHero ? "auto" : "none";
						if (shouldPlayHero) resumeTopography(heroBlobCanvas);
						else pauseTopography(heroBlobCanvas);
					}

					const shouldPlayTransition = self.progress > PROGRESS_EPSILON;
					if (shouldPlayTransition !== transitionPlaying) {
						transitionPlaying = shouldPlayTransition;
						transitionBlob.style.pointerEvents = shouldPlayTransition ? "auto" : "none";
						if (shouldPlayTransition) resumeTopography(transitionBlobCanvas);
						else pauseTopography(transitionBlobCanvas);
					}

					// Persegue a foto quadro a quadro (ver comentário longo em
					// `syncMarqueeToPhotoCenter` acima).
					//
					// Correção (bug real — marquee "travava" desalinhado da
					// foto): antes só chamava isso enquanto `self.progress <=
					// MAIN_TRANSITION` — `self.progress` é o progresso CRU do
					// scroll, sem o atraso do `scrub`; a posição renderizada
					// da foto (`photoScale`/`photoSlot`) é que fica ~0.3s
					// atrás (é o próprio `scrub` fazendo o trabalho dele). Se
					// o scroll avança rápido o bastante, `self.progress`
					// passa de `MAIN_TRANSITION` ANTES da foto (ainda em
					// atraso) terminar de chegar na posição final — o rastreio
					// parava exatamente nesse intervalo, "congelando" o
					// marquee alguns pixels atrás de onde a foto ainda ia
					// terminar de se mover. Chamar sempre (sem a condição)
					// custa 2 `getBoundingClientRect()` a mais por tick só
					// durante o scroll — preço baixo por eliminar de vez a
					// possibilidade de desalinho.
					syncMarqueeToPhotoCenter();
				},
			},
		});

		// Texto some quase instantâneo, junto com o primeiro pixel de scroll.
		tl.to([headline, tagline, scrollCue], { autoAlpha: 0, ease: "none", duration: TEXT_FADE }, 0);

		// Cross-fade rápido inicial (colorida) -> final (P&B). Sem mudança
		// de escala aqui — a foto já nasce no tamanho normal do Figma.
		tl.to(photoInicial, { opacity: 0, ease: "none", duration: PHOTO_CROSSFADE }, 0).to(
			photoFinal,
			{ opacity: 1, ease: "none", duration: PHOTO_CROSSFADE },
			0,
		);

		// Transição principal: escala pro tamanho final, fundo escurece,
		// blobs trocam — tudo termina cedo (~22% do scroll), o resto do
		// scroll só segura o estado escuro/marquee.
		// Cor do nav (correção rodada 6): fica sempre fixa em
		// --color-nav-link-on-light (#444342, confirmado no Figma
		// 214:89/87/91/93) — não anima mais para navLinkOnDark.
		//
		// Correção (rodada 9 — bug de flicker): `backgroundColor` força
		// repaint caro a cada tick de scrub (não é compositor-only como
		// opacity/transform) — num elemento `position:fixed` do tamanho da
		// tela isso é pesado o bastante pra derrubar frames. Trocado por um
		// overlay sólido separado (`darkOverlay`) cuja `opacity` anima —
		// visualmente idêntico (o overlay cobre o stage inteiro com a
		// mesma cor), mas opacity é compositor-only.
		tl.to(photoScale, { scale: getFinalPhotoScale, ease: "none", duration: MAIN_TRANSITION }, 0)
			.to(darkOverlay, { opacity: 1, ease: "none", duration: MAIN_TRANSITION }, 0)
			.to(marquee, { autoAlpha: 1, ease: "none", duration: MAIN_TRANSITION }, 0)
			.to(heroBlob, { autoAlpha: 0, ease: "none", duration: MAIN_TRANSITION }, 0)
			.to(transitionBlob, { autoAlpha: 1, ease: "none", duration: MAIN_TRANSITION }, 0);

		// Sobe a foto do repouso (canto inferior) até o centro da stage,
		// junto com o resto da transição principal — em QUALQUER largura
		// agora (era só mobile antes, ver correção acima). Vai no
		// `.hero-photo-slot` (não no `.hero-photo-parallax`) de propósito
		// — esse já é dono do translate do parallax de mouse no desktop
		// (mesmo eixo `y`, HeroPhoto.astro/mouseParallax.ts), então usar
		// um elemento diferente evita os 2 tweens brigarem pelo mesmo
		// eixo no desktop.
		tl.to(photoSlot, { y: getPhotoCenterOffsetY, ease: "none", duration: MAIN_TRANSITION }, 0);

		// Ancora o comprimento total do timeline em exatamente 1 — o resto
		// do scroll (depois de MAIN_TRANSITION) só "segura" o estado final.
		tl.set({}, {}, 1);
	}
</script>
