---
/**
 * Wrapper genérico pras seções internas do case (Problema, Restrições,
 * Pesquisa, Decisão, MVP, Outcome, "O que eu faria diferente") — todas
 * seguem o mesmo padrão no Figma: `h4` (título da seção) + conteúdo,
 * mesmo padding horizontal. Reaproveitado 7x nesta página (regra do
 * CLAUDE.md: só abstrai depois que o padrão se repete 2+ vezes).
 *
 * `titleKey` (não `title` solto) porque esses 7 títulos são um TEMPLATE
 * fixo reaproveitado por todo case study (ARCHITECTURE.md) — a tradução
 * EN vive centralizada em src/lib/i18n.ts (`case.section.*`), igual ao
 * resto da nav/UI fixa do site, em vez de duplicar a chave a cada case
 * novo.
 */
import { translations } from "../../lib/i18n";

type SectionKey = "problema" | "restricoes" | "pesquisa" | "decisao" | "mvp" | "entregue" | "outcome" | "diferente";

interface Props {
	titleKey: SectionKey;
	class?: string;
}

const { titleKey, class: className = "" } = Astro.props;
const i18nKey = `case.section.${titleKey}`;
const title = translations[i18nKey]?.pt ?? titleKey;
---

<section class:list={["flex flex-col gap-(--spacing-lg) px-(--spacing-md-plus) tablet:px-(--spacing-5xl) wide:px-[max(120px,calc((100vw-1440px)/2))]", className]}>
	<h4 class="font-sans text-[20px] leading-[1.3] font-bold text-(--color-foreground-on-light) tablet:text-[32px]" data-i18n={i18nKey}>
		{title}
	</h4>
	<div class="flex flex-col gap-(--spacing-md) font-sans text-[16px] leading-[1.5] text-(--color-foreground-on-light) [&_ul]:flex [&_ul]:list-disc [&_ul]:flex-col [&_ul]:gap-(--spacing-sm) [&_ul]:pl-(--spacing-lg) tablet:text-[20px]">
		<slot />
	</div>
</section>
