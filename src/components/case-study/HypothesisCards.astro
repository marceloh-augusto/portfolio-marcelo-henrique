---
/**
 * Cards de hipótese da seção "Pesquisa" — Figma node 271:245 (desktop) e
 * 346:307 (mobile). Estrutura idêntica nos dois breakpoints (só o
 * tamanho de fonte do rótulo/badge muda, 12px→14px — Typography/UI/Caption,
 * ver @DESIGN.md); no mobile empilha (`flex-col`), no desktop vira uma
 * linha de colunas iguais (`flex-row`, cada card `flex-1`).
 *
 * `status`/`title`/`description` são conteúdo específico de cada
 * hipótese do case — cada um aceita um par `*En` opcional (mecanismo
 * `data-i18n-en`, ver i18n.ts). O rótulo "HIPÓTESE N" é gerado pelo
 * índice do item (não é campo de conteúdo).
 *
 * Badge: status "VALIDADA" usa o token `success` (verde, texto branco —
 * Figma 869:722, `badge-status-success` em DESIGN.md) em todos os cases;
 * qualquer outro status (ex: "REFUTADA") mantém a badge neutra.
 *
 * `variant="strong"` (Yogha, Figma 869:719): título em negrito e descrição
 * em neutral-800. O padrão é o estilo do Estratégia (título regular,
 * descrição em neutral-500).
 */
interface HypothesisItem {
	status: string;
	statusEn?: string;
	title: string;
	titleEn?: string;
	description: string;
	descriptionEn?: string;
}

interface Props {
	items: HypothesisItem[];
	variant?: "default" | "strong";
}

const { items, variant = "default" } = Astro.props;
const strong = variant === "strong";

const isValidated = (status: string) => status.trim().toUpperCase() === "VALIDADA";
---

<div class="flex flex-col gap-(--spacing-lg) tablet:flex-row tablet:items-stretch" data-reveal-group>
	{
		items.map((item, i) => (
			<div class="flex flex-1 flex-col gap-[14px] rounded-card bg-(--color-neutral-100) px-[28px] py-(--spacing-lg)">
				<div class="flex items-center justify-between">
					<p class="font-sans text-[12px] font-bold whitespace-nowrap text-(--color-muted) tablet:text-[14px]" data-i18n-en={`HYPOTHESIS ${i + 1}`}>
						{`HIPÓTESE ${i + 1}`}
					</p>
					<div
						class:list={[
							"flex items-start rounded-full px-(--spacing-sm-plus) py-[5px]",
							isValidated(item.status) ? "bg-(--color-success)" : "bg-(--color-neutral-200)",
						]}
					>
						<p
							class:list={[
								"font-sans text-[12px] font-bold whitespace-nowrap tablet:text-[14px]",
								isValidated(item.status) ? "text-white" : "text-(--color-neutral-500)",
							]}
							data-i18n-en={item.statusEn}
						>
							{item.status}
						</p>
					</div>
				</div>
				<p
					class:list={[
						"font-sans text-[16px] leading-[1.5] text-(--color-foreground-on-light) tablet:text-[20px]",
						strong && "font-bold tablet:leading-[1.4]",
					]}
					data-i18n-en={item.titleEn}
				>
					{item.title}
				</p>
				<p
					class:list={[
						"font-sans text-[16px] leading-[1.5] tablet:text-[20px]",
						strong ? "text-(--color-neutral-800)" : "text-(--color-neutral-500)",
					]}
					data-i18n-en={item.descriptionEn}
				>
					{item.description}
				</p>
			</div>
		))
	}
</div>
