---
/**
 * Abre a página de um case — Figma node 308:216 (Yogha). `h3` (headline
 * completo do case, texto do node 308:217 — DIFERENTE da `description`
 * curta usada no card da Home, ver content.config.ts) + imagem de capa
 * full-width abaixo, clicável (abre no Lightbox).
 *
 * `aspect-[1280/834]` bate com a imagem exportada do Figma (1280×834) —
 * ver CasesSection.astro pro mesmo padrão de imagem-com-proporção-fixa.
 */
interface Props {
	headline: string;
	headlineEn?: string;
	image: string;
	imageAlt: string;
	/** Proporção do quadro (ex: "1200/675"). Default: 1280/834 (Yogha). */
	imageAspect?: string;
	/** `contain` = imagem inteira sobre fundo `#fdfdfd` (Estratégia, Figma 564:560). */
	imageFit?: "cover" | "contain";
}

const { headline, headlineEn, image, imageAlt, imageAspect = "1280/834", imageFit = "cover" } = Astro.props;
---

<section class="flex flex-col gap-(--spacing-lg) px-(--spacing-md-plus) tablet:gap-(--spacing-xl) tablet:px-(--spacing-5xl) wide:px-[max(120px,calc((100vw-1440px)/2))]" data-reveal-group>
	<h3
		class="font-sans text-[28px] leading-[1.3] font-bold text-(--color-foreground-on-light) tablet:text-[40px]"
		data-i18n-en={headlineEn}
	>
		{headline}
	</h3>

	<button
		type="button"
		class:list={["block w-full cursor-zoom-in overflow-hidden rounded-lg tablet:rounded-xl", imageFit === "contain" && "bg-[#fdfdfd]"]}
		style={`aspect-ratio: ${imageAspect}`}
		data-lightbox-trigger
		data-lightbox-src={image}
		data-lightbox-alt={imageAlt}
		data-lightbox-group="case-media"
	>
		<img src={image} alt={imageAlt} class:list={["h-full w-full", imageFit === "contain" ? "object-contain" : "object-cover"]} loading="eager" />
	</button>
</section>
